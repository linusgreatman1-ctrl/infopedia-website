// Infopedia Technology website — database schema.
// Same architecture as the sibling Handa/PassNow backends: Prisma +
// PostgreSQL, bcrypt-hashed passwords, JWT access tokens backed by
// hashed-and-revocable refresh tokens stored in their own table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  refreshTokens   RefreshToken[]
  reviewResponses Review[]         @relation("ReviewResponder")
  blogPosts       BlogPost[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  revoked   Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// A review of Infopedia Technology's services, submitted publicly from the
// site's Reviews section — no account required to leave one.
model Review {
  id      String @id @default(uuid())
  name    String
  company String?
  rating  Int // 1-5
  comment String

  hidden Boolean @default(false) // admin moderation — hidden reviews are excluded from public listings but kept for the record

  response            String?
  respondedAt         DateTime?
  respondedByAdminId  String?
  respondedByAdmin    AdminUser? @relation("ReviewResponder", fields: [respondedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([hidden])
}

// A submission from the site's Contact form.
model ContactMessage {
  id      String  @id @default(uuid())
  name    String
  email   String
  service String?
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([read])
}

// A blog/news article, written and published from the admin dashboard.
model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  featuredImage  String?
  category       String?
  tags           String? // comma-separated
  seoTitle       String?
  seoDescription String?

  published   Boolean   @default(false)
  publishedAt DateTime?

  authorId   String?
  author     AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String // snapshot, kept even if the admin account is later removed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// An uploaded image/file, tracked so the admin dashboard can list and
// reuse it (e.g. as a blog post's featured image) without re-uploading.
model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

// Site-wide settings editable from the admin dashboard. Always exactly one
// row (id "singleton"), upserted rather than created per-request.
model SiteSettings {
  id           String   @id @default("singleton")
  linkedinUrl  String?
  facebookUrl  String?
  instagramUrl String?
  xUrl         String?
  updatedAt    DateTime @updatedAt
}

// A client testimonial shown on the homepage. Admin-authored (unlike
// Review, which visitors submit themselves), so every row is shown — no
// moderation flag needed.
model Testimonial {
  id       String  @id @default(uuid())
  quote    String
  name     String
  role     String?
  company  String?
  avatar   String? // 2-letter initials shown in the avatar circle; derived from name if left blank
  position Int     @default(0) // display order, ascending

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
