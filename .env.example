# Copy this file to .env for local development (Render/Railway etc. — set
# these as real environment variables in the host's dashboard instead of
# uploading a .env file).

# Required before deploying — the password used to sign into /admin.html.
ADMIN_PASSWORD=change-me-to-something-real

# Port the server listens on. Most hosts (Render, Railway) set this
# automatically — leave unset in that case.
PORT=5050

# Optional: email notifications on every new review / contact submission.
# Leave any of these unset to skip email entirely — submissions are always
# saved to data/reviews.json and data/contacts.json regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=info@infopediatech.com
