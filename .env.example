# Copy this file to .env for local development (Render/Railway etc. — set
# these as real environment variables in the host's dashboard instead of
# uploading a .env file).

NODE_ENV=development

# Port the server listens on. Most hosts (Render, Railway) set this
# automatically — leave unset in that case.
PORT=5050

# Postgres connection string (Prisma). Production uses a free Supabase
# project (Render's own free Postgres is capped at one per account, and
# that slot is already used by a sibling app). Use Supabase's *session*
# pooler connection string (port 5432 on the pooler host, e.g.
# aws-1-<region>.pooler.supabase.com), not the direct db.<ref>.supabase.co
# host (unreachable from Render — IPv6-only) and not the *transaction*
# pooler on port 6543 (hangs indefinitely during `prisma migrate deploy`).
DATABASE_URL=postgresql://user:password@localhost:5432/infopedia

# Origin(s) allowed to call the API with credentials (comma-separated).
# Leave unset or "*" to allow any origin.
CLIENT_ORIGIN=

# Signing secrets for JWT access/refresh tokens — use long random strings,
# different from each other. On Render, generate these instead of typing
# them in by hand.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# Admin account seeded automatically on first boot (only if this email
# doesn't already exist — redeploys never overwrite a changed password).
ADMIN_EMAIL=admin@infopediatech.com
ADMIN_NAME=Infopedia Admin
ADMIN_PASSWORD=change-me-to-something-real

# Optional: email notifications on every new review / contact submission.
# Leave any of these unset to skip email entirely — submissions are always
# saved to the database regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=info@infopediatech.com
